{
  "name": "react-dockable-desktop",
  "version": "3.1.0",
  "description": "A premium, state-of-the-art window manager and dockable layout engine for React. Supports fluid grid splits, tabbed groups, floating resizable windows, zero-unmount state preservation, context menus, and internationalization.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipecarrillo100/react-dockable-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/felipecarrillo100/react-dockable-desktop/issues"
  },
  "homepage": "https://github.com/felipecarrillo100/react-dockable-desktop#readme",
  "type": "module",
  "scripts": {
    "dev": "vite demo",
    "dev:ria": "vite demo-luciadria",
    "dev:oldria": "vite demo-oldria",
    "build": "tsup && node -e \"require('fs').copyFileSync('src/index.css', 'dist/styles.css')\"",
    "demo:build": "vite build --base /react-dockable-desktop/demo/",
    "docs:dev": "vitepress dev docs-site",
    "docs:generate": "typedoc",
    "docs:build": "vitepress build docs-site",
    "docs:preview": "vitepress preview docs-site",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0",
    "replace-react-contexify": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@monaco-editor/react": "^4.6.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "bootstrap": "^5.3.8",
    "copyfiles": "^2.4.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.6",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-submenu": "^4.0.0",
    "react-dom": "^19.2.6",
    "react-intl": "^10.1.12",
    "replace-react-contexify": "^1.1.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8"
  }
}
